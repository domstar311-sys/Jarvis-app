name: Build JARVIS APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v3
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      - name: Install deps
        run: |
          sudo apt update
          sudo apt install -y python3-pip openjdk-17-jdk zip unzip libffi-dev
          pip install buildozer cython==0.29.33
      - name: Unzip and prepare
        run: |
          unzip -o "*.zip" || unzip -o "**/*.zip" || true
          ls -R
          # Find main.py
          find. -name "main.py" -exec cp {}./main.py \; || true
          find. -name "buildozer.spec" -exec cp {}./buildozer.spec \; || true
          cp JarvisApp/main.py./main.py 2>/dev/null || true
          cp JarvisApp/buildozer.spec./buildozer.spec 2>/dev/null || true
          cp -r JarvisApp/.github./.github 2>/dev/null || true
      - name: Build APK
        run: buildozer android debug
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: JARVIS-APK
          path: bin/*.apk
